# API key for Gemini 2.5 Flash and text-embedding-004 vision and embeddings models
GEMINI_API_KEY=your_gemini_api_key_here

# API key for Groq llama-3.3-70b-versatile fallback LLM
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL database connection URL (Neon.tech instance)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Secret key used for signing httpOnly auth JWT cookies (min 32 chars recommended)
JWT_SECRET=super_secret_jwt_key_change_me_in_prod_12345

# Execution environment: development or production (controls rate limits & cookie security)
NODE_ENV=development

# --- Push notifications (web-push VAPID keys) ---
# VAPID public key for web push subscriptions (exposed to browser client)
VAPID_PUBLIC_KEY=your_vapid_public_key

# VAPID private key for signing server-sent push payloads
VAPID_PRIVATE_KEY=your_vapid_private_key

# VAPID subject email or contact URI for push service registration
VAPID_SUBJECT=mailto:admin@sachthali.com

# --- Payments (Razorpay test mode keys) ---
# Razorpay public key ID for client checkout widget initialization
RAZORPAY_KEY_ID=rzp_test_sample_key_id

# Razorpay secret key for server API authentication and webhook signature verification
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key
