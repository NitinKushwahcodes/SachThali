# Sachthali Backend Environment Configuration Example
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
JWT_SECRET=your_secure_random_jwt_secret_key_at_least_32_chars
FRONTEND_URL=https://main.d123456abcdef.amplifyapp.com

# AI API Keys
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GROQ_API_KEY=gsk_YourGroqApiKeyHere

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@sachthali.com

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Photo Retention AWS S3 Storage (Phase 5 Part B2)
AWS_S3_BUCKET_NAME=sachthali-meal-photos-prod
AWS_S3_REGION=ap-south-1
