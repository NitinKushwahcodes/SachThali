// Prisma database schema for Sachthali application.
// Defines User, Profile, DailyLog, MealEntry, RetrievalMiss, LoggingPattern, PushSubscription, and Subscription models.
// Maps PostgreSQL database tables for authentication, meal tracking, push notifications, and Razorpay subscriptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  deviceToken       String             @unique @default(cuid())
  email             String?            @unique
  passwordHash      String?
  visitCount        Int                @default(1)
  lastVisitAt       DateTime           @default(now())
  createdAt         DateTime           @default(now())
  profile           Profile?
  dailyLogs         DailyLog[]
  loggingPattern    LoggingPattern?
  pushSubscriptions PushSubscription[]
  subscription      Subscription?
  rewardPoints      RewardPoints?
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  goal                 String   // weight_loss | weight_gain | general_health | skin | medical | just_checking
  dietType             String?  // veg | egg | non_veg | jain
  heightCm             Int?
  weightKg             Float?
  ageRange             String?  // "18-25" etc, coarse
  activityLevel        String?  // low | medium | high
  region               String?
  hasMedicalContext    Boolean  @default(false)
  fullName             String?
  email                String?
  phone                String?
  age                  Int?
  gender               String?  // "male" | "female" | "prefer_not_to_say"
  purpose              String?  // "general" | "diet_tracking" | "calorie_tracking" | "weight_loss" | "weight_gain"
  hasHealthCondition   Boolean  @default(false)
  conditionDescription String?
  conditionSeverity    String?  // "mild" | "moderate" | "severe"
  consultingDoctor     Boolean?
  calorieTarget        Int?
  proteinTargetG       Int?
  isEstimate           Boolean  @default(false) // true if height/weight were missing
  updatedAt            DateTime @updatedAt
}

model DailyLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  date      DateTime    @db.Date
  totalKcal Int         @default(0)
  meals     MealEntry[]

  @@unique([userId, date])
}

model MealEntry {
  id          String   @id @default(cuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id])
  loggedAt    DateTime @default(now())
  dishName    String
  portionUnit String   // katori | piece | plate | cup | g
  portionQty  Float
  kcalMin     Int
  kcalMax     Int
  kcal        Int
  confidence  String   // high | medium | low
  oilLevel    String?  // low | normal | high
  mealSlot    String   @default("lunch") // "breakfast" | "lunch" | "dinner" | "snack"
  tier        Int      @default(3) // 1-5 score
  photoUrl    String?  // 24-hour retained meal photo URL (null after 24h)
}

model RetrievalMiss {
  id               String   @id @default(cuid())
  queryText        String
  topMatchName     String?
  topMatchScore    Float?
  resolvedDishName String?
  createdAt        DateTime @default(now())
}

model LoggingPattern {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  avgBreakfastMin Int?
  avgLunchMin     Int?
  avgDinnerMin    Int?
  updatedAt       DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  razorpayOrderId String    @unique
  plan            String    @default("monthly")
  status          String
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model RewardPoints {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  patiencePoints   Int      @default(0)
  balancePoints    Int      @default(0)
  completionPoints Int      @default(0)
  updatedAt        DateTime @updatedAt
}
