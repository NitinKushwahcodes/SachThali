// Prisma database schema for Sachthali application.
// Defines User, Profile, DailyLog, MealEntry, RetrievalMiss, LoggingPattern, PushSubscription, and Subscription models.
// Maps PostgreSQL database tables for authentication, meal tracking, push notifications, and Razorpay subscriptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  profile           Profile?
  dailyLogs         DailyLog[]
  loggingPattern    LoggingPattern?
  pushSubscriptions PushSubscription[]
  subscription      Subscription?
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  goal              String   // weight_loss | weight_gain | general_health | skin | medical | just_checking
  dietType          String?  // veg | egg | non_veg | jain
  heightCm          Int?
  weightKg          Float?
  ageRange          String?  // "18-25" etc, coarse
  activityLevel     String?  // low | medium | high
  region            String?
  hasMedicalContext Boolean  @default(false)
  calorieTarget     Int?
  proteinTargetG    Int?
  isEstimate        Boolean  @default(false) // true if height/weight were missing
  updatedAt         DateTime @updatedAt
}

model DailyLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  date      DateTime    @db.Date
  totalKcal Int         @default(0)
  meals     MealEntry[]

  @@unique([userId, date])
}

model MealEntry {
  id          String   @id @default(cuid())
  dailyLogId  String
  dailyLog    DailyLog @relation(fields: [dailyLogId], references: [id])
  loggedAt    DateTime @default(now())
  dishName    String
  portionUnit String   // katori | piece | plate | cup | g
  portionQty  Float
  kcalMin     Int
  kcalMax     Int
  kcal        Int
  confidence  String   // high | medium | low
  oilLevel    String?  // low | normal | high
}

model RetrievalMiss {
  id            String   @id @default(cuid())
  queryText     String
  topMatchName  String?
  topMatchScore Float?
  createdAt     DateTime @default(now())
}

model LoggingPattern {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  avgBreakfastMin Int?
  avgLunchMin     Int?
  avgDinnerMin    Int?
  updatedAt       DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
}

model Subscription {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  razorpayOrderId String    @unique
  status          String
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}
